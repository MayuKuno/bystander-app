# Password for /admin (see server/utils/adminAuth.ts). Required — with this
# unset, admin login is always rejected rather than falling back to a default.
NUXT_ADMIN_PASSWORD=

# Remote Turso DB (see server/utils/db.ts). Leave both unset for local dev
# (falls back to file:./.data/app.db). Set both when deploying to Vercel.
NUXT_TURSO_DATABASE_URL=
NUXT_TURSO_AUTH_TOKEN=
